# Configuración local del servidor LiveBid.
# Copiar a .env y reemplazar todos los valores de ejemplo.
PORT=3000
POSTGRES_USER=livebid_admin
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://livebid_admin:replace-with-a-local-password@localhost:5432/livebid_db
JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=replace-with-provider-key
CIRCUIT_BREAKER_TIMEOUT_MS=2000
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
