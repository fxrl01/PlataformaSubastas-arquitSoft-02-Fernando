# Configuración del Servidor LiveBid
PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Conexión Base de Datos Relacional (PostgreSQL)
DATABASE_URL=postgresql://livebid_admin:livebid_secure_password_2026@localhost:5432/livebid_db

# Conexión Caché y Locks en Memoria (Redis)
REDIS_URL=redis://localhost:6379

# Integraciones Externas
GEMINI_API_KEY=your_gemini_api_key_here
CIRCUIT_BREAKER_TIMEOUT_MS=2000
CIRCUIT_BREAKER_FAIL_THRESHOLD=3
